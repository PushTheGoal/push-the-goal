---
import { site } from '../data/site';
interface Props { heading?: string; button?: string }
const {
  heading = 'Your Athlete Has Already Done the Hard Part',
  button = 'Book Your Recruiting Strategy Call',
} = Astro.props;
---
<section class="band" aria-labelledby="band-h">
  <div class="wrap inner">
    <div class="copy">
      <h2 id="band-h">{heading}</h2>
      <slot>
        <p>The early mornings, the two-a-days, the long seasons: that work is already done. Don't let the one part nobody taught your family, the recruiting part, get in the way of what your athlete has earned. Let's build the plan together, and make sure the right coaches see what you already know.</p>
      </slot>
    </div>
    <div class="actions">
      <a class="btn dark" href={site.booking}>{button}</a>
      <a class="btn line" href={site.instagram}>DM on Instagram</a>
    </div>
  </div>
</section>
<style>
  .band { background: var(--gold); color: var(--ink); }
  .inner { display: flex; flex-wrap: wrap; gap: 32px; align-items: center; padding-top: 80px; padding-bottom: 80px; max-width: 1100px; }
  .copy { flex: 1 1 520px; min-width: 0; }
  h2 { color: var(--ink); }
  p { font-size: 18px; margin: 0; }
  .actions { flex: 0 1 340px; display: grid; gap: 12px; }
  .dark { background: var(--ink); border-color: var(--ink); color: var(--gold); }
  .dark:hover { background: #26262b; color: var(--gold); }
  .line { border-color: var(--ink); color: var(--ink); }
  .line:hover { background: var(--ink); color: var(--gold); }
</style>
