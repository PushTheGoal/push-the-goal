---
// Renders a page carried over from the old Elementor layout (src/data/pages/<slug>.json):
// same words, same order, same buttons, in the new design.
import { Image } from 'astro:assets';
import Faq from './Faq.astro';
import Testimonials from './Testimonials.astro';
import { site } from '../data/site';

interface Block { type: string; html?: string; text?: string; items?: any[]; links?: { href: string; text: string }[] }
interface Section { dark: boolean; eyebrow: string | null; heading: string | null; h1: string | null; blocks: Block[]; image: string | null; buttons: { text: string; href: string }[] }
interface Props { sections: Section[]; heroImage?: string }
const { sections, heroImage = 'coaching-tablet' } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const img = (name: string | null) => (name ? photos[`../assets/photos/${name}.jpg`]?.default : undefined);
const alts: Record<string, string> = {
  'coaching-tablet': 'Izi going over a play on a tactics board with an athlete',
  'izi-two-athletes': 'Izi on the field with two of her athletes',
  'team-indoor': 'A group of young players lined up on an indoor field',
  'champions-team': 'A girls team celebrating with a championship banner',
  'izi-field': 'Izi on a training field at sunset',
};
const btnClass = (b: { href: string }, i: number) => (b.href.includes('instagram') || i > 0 ? 'btn btn-outline' : 'btn btn-primary');
const [hero, ...rest] = sections;
const heroPhoto = img(heroImage);
---
<section class="hero">
  {heroPhoto && <Image src={heroPhoto} alt="" class="hero-bg" widths={[800, 1400]} sizes="100vw" loading="eager" />}
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="wrap hero-in">
    <nav aria-label="Breadcrumb" class="crumbs"><a href="/">Home</a> / <span>{hero.h1}</span></nav>
    <h1>{hero.h1}</h1>
    {hero.blocks.filter((b) => b.type === 'html').map((b) => <div class="lead" set:html={b.html} />)}
    <div class="btn-row">
      {hero.buttons.map((b, i) => <a class={btnClass(b, i)} href={b.href}>{b.text}</a>)}
    </div>
    <p class="proof">Trusted by parents from {site.proof.clubs} clubs and divisions</p>
  </div>
</section>

{rest.map((s, n) => {
  const photo = img(s.image);
  const hasFaq = s.blocks.some((b) => b.type === 'faq');
  const tone = s.dark ? 'section' : n % 4 === 1 ? 'section section-light' : 'section section-alt';
  const id = (s.heading || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const body = (
    <Fragment>
      {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
      {s.heading && <h2 id={id}>{s.heading}</h2>}
      {s.blocks.map((b) => {
        if (b.type === 'html') return <div class="rich" set:html={b.html} />;
        if (b.type === 'h3') return <h3>{b.text}</h3>;
        if (b.type === 'list') return <ul class="ticks">{b.items!.map((t) => <li>{t}</li>)}</ul>;
        if (b.type === 'step') return <div class="step card rich" set:html={b.html} />;
        if (b.type === 'readmore') return (
          <div class="readmore"><p class="eyebrow">Read more</p><ul>{b.links!.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul></div>
        );
        if (b.type === 'faq') return <Faq items={b.items!} />;
        if (b.type === 'testimonials') return <Testimonials />;
        return null;
      })}
      {s.buttons.length > 0 && <div class="btn-row spaced">{s.buttons.map((b, i) => <a class={btnClass(b, i)} href={b.href}>{b.text}</a>)}</div>}
    </Fragment>
  );
  return (
    <section class={tone} aria-labelledby={id || undefined}>
      <div class:list={['wrap', { narrow: hasFaq || (!photo && s.blocks.length > 6) }]}>
        {photo ? (
          <div class:list={['split', { reverse: n % 2 === 1 }]}>
            <div><Image src={photo} alt={alts[s.image!] ?? ''} class="photo" widths={[480, 900]} sizes="(max-width: 900px) 100vw, 560px" /></div>
            <div>{body}</div>
          </div>
        ) : <div class:list={{ center: hasFaq }}>{body}</div>}
      </div>
    </section>
  );
})}

<style>
  .hero { position: relative; overflow: hidden; min-height: 520px; display: flex; align-items: center; }
  .hero :global(.hero-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,11,14,0.95) 0%, rgba(11,11,14,0.85) 50%, rgba(11,11,14,0.45) 100%); }
  .hero-in { position: relative; width: 100%; padding-top: 72px; padding-bottom: 72px; }
  .hero-in h1 { max-width: 820px; }
  .hero-in .lead { max-width: 640px; margin-bottom: 24px; }
  .crumbs { font-size: 14px; color: var(--dim); margin-bottom: 18px; }
  .crumbs a { color: var(--dim); }
  .proof { margin: 24px 0 0; font-family: var(--display); letter-spacing: 2px; text-transform: uppercase; color: var(--gold); font-size: 15px; }
  .rich :global(p) { margin: 0 0 16px; }
  .rich :global(ul) { padding-left: 22px; }
  .step { padding: 18px 22px; margin-bottom: 12px; color: var(--muted); }
  .step :global(p:last-child) { margin: 0; }
  .step :global(b), .step :global(strong) { color: var(--gold); }
  .readmore { border: 1px solid var(--line); border-left: 3px solid var(--gold); border-radius: 0; padding: 16px 20px; margin: 0 0 32px; background: var(--panel); }
  .readmore .eyebrow { font-size: 13px; margin-bottom: 6px; }
  .readmore ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; }
  .section-light .readmore { background: #fff; border-color: #d4d4d8; border-left-color: #c9ad00; }
  .spaced { margin-top: 24px; }
  .center .btn-row { justify-content: center; }
  h3 { margin-top: 36px; }
</style>
