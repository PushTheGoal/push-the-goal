---
import { Image } from 'astro:assets';
import logo from '../assets/photos/logo.jpg';
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
---
<header class="top">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Push The Goal home">
      <Image src={logo} alt="" width={44} height={50} loading="eager" />
      <span>Push The Goal</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-primary book" href={site.booking}>Book a Call</a>
  </div>
</header>

<style>
  .top { border-bottom: 1px solid #23242a; background: rgba(11, 11, 14, 0.96); position: sticky; top: 0; z-index: 20; backdrop-filter: blur(6px); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 28px; padding-top: 10px; padding-bottom: 10px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--text); font-family: var(--display); font-weight: 600; font-size: 20px; letter-spacing: 1px; text-transform: uppercase; }
  .brand :global(img) { width: 44px; height: 50px; object-fit: contain; }
  nav { flex: 1 1 auto; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 22px; }
  nav a { color: var(--text); text-decoration: none; font-family: var(--display); font-size: 15px; letter-spacing: 1px; text-transform: uppercase; display: inline-block; padding: 10px 0; }
  nav a:hover, nav a[aria-current='page'] { color: var(--gold); }
  .book { min-height: 44px; padding: 10px 18px; font-size: 15px; }
  @media (max-width: 760px) {
    .top { position: static; }
    .bar { justify-content: space-between; }
    nav { order: 3; flex-basis: 100%; }
    nav ul { justify-content: flex-start; gap: 0 18px; }
  }
</style>
