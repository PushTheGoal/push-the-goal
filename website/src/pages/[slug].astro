---
// Blog posts and the legal pages both live at /<slug>/, exactly where WordPress had them.
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../data/site';
import izi from '../assets/photos/izi-field.jpg';

export async function getStaticPaths() {
  const now = new Date();
  const posts = await getCollection('blog', (p) => !p.data.draft && p.data.date <= now);
  const legal = await getCollection('legal');
  return [
    ...posts.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'post' as const, entry, all: posts } })),
    ...legal.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'legal' as const, entry, all: [] } })),
  ];
}

type Props =
  | { kind: 'post'; entry: CollectionEntry<'blog'>; all: CollectionEntry<'blog'>[] }
  | { kind: 'legal'; entry: CollectionEntry<'legal'>; all: [] };
const { kind, entry, all } = Astro.props as Props;
const { Content } = await render(entry);

let post: CollectionEntry<'blog'> | undefined, related: CollectionEntry<'blog'>[] = [], schema: object[] = [];
if (kind === 'post') {
  post = entry as CollectionEntry<'blog'>;
  related = all.filter((p) => p.id !== post!.id && p.data.category === post!.data.category)
    .sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
  // FAQ schema from the post's own "## FAQ" section (bold question, answer on the next line)
  const faqPart = (post.body ?? '').split(/^## FAQ\s*$/m)[1] ?? '';
  const faqs = [...faqPart.matchAll(/^\*\*(.+?\?)\*\*\s*\n([^\n*#][^\n]*)/gm)].map((m) => ({ q: m[1], a: m[2].trim() }));
  schema = [{
    '@context': 'https://schema.org', '@type': 'BlogPosting',
    headline: post.data.title, description: post.data.description,
    datePublished: post.data.date.toISOString(), mainEntityOfPage: `${site.url}/${post.id}/`,
    author: { '@id': `${site.url}/#izi` }, publisher: { '@id': `${site.url}/#organization` },
    ...(post.data.image ? { image: new URL(post.data.image.src, site.url).href } : {}),
  }];
  if (faqs.length) schema.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') } })),
  });
}
const d = post?.data;
const words = (entry.body ?? '').split(/\s+/).length;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const title = kind === 'post' ? `${d!.seoTitle}` : `${entry.data.title} | Push The Goal`;
const chapters = ['How recruiting works', 'The timeline, grade by grade', 'D1, D2, D3, NAIA and JUCO', "Getting on a coach's radar", 'The highlight video', 'How the money works', 'Where families waste money'];
---
<Base title={title} description={entry.data.description} type={kind === 'post' ? 'article' : 'website'} image={d?.image?.src} schema={schema}>
  {kind === 'legal' ? (
    <article class="section">
      <div class="wrap">
        <h1>{entry.data.title}</h1>
        <div class="prose legal"><Content /></div>
      </div>
    </article>
  ) : (
    <article>
      <header class="wrap post-head">
        <nav aria-label="Breadcrumb" class="crumbs"><a href="/">Home</a> / <a href="/blog/">Blog</a> / {d!.category}</nav>
        <div class="split">
          <div>
            <p class="eyebrow">{d!.category} · {Math.max(3, Math.round(words / 220))} min read</p>
            <h1>{d!.title}</h1>
            <div class="byline">
              <Image src={izi} alt="" width={52} height={52} />
              <div><p class="who">Coach Izi Murray</p><p class="meta">Former NCAA Division I player · {fmt(d!.date)}</p></div>
            </div>
          </div>
          {d!.image && <div><Image src={d!.image} alt="" class="hdr" widths={[600, 1100]} sizes="(max-width: 900px) 100vw, 560px" loading="eager" /></div>}
        </div>
      </header>
      <div class="wrap post-body">
        <div class="main">
          <div class="prose"><Content /></div>
          <p class="guide-line">This post is one chapter of our <a href="/college-soccer-recruitment/">complete guide to college soccer recruiting</a>.</p>
          <div class="cta">
            <p class="cta-h">Want a plan built for your athlete?</p>
            <p>Book a free strategy call. We'll look at where your athlete stands and what to do next.</p>
            <div class="btn-row">
              <a class="btn dark" href={site.booking}>Book Your Recruiting Strategy Call</a>
              <a class="btn line" href={site.instagram}>DM on Instagram</a>
            </div>
          </div>
          <div class="bio card">
            <Image src={izi} alt="" width={96} height={96} />
            <div>
              <p class="bio-h">About Coach Izi Murray</p>
              <p>Izi played two years of junior college soccer, transferred to Division I, and came back from five knee surgeries to finish her career. Nobody gave her good odds. She founded Push The Goal to give soccer families the honest recruiting guidance she wishes every athlete had. <a href="/about-izi/">More about Izi</a></p>
            </div>
          </div>
        </div>
        <aside class="side">
          <div class="card box">
            <p class="eyebrow">The complete guide</p>
            <p class="box-h">College Soccer Recruitment, Explained for Parents</p>
            <ol>{chapters.map((c) => <li>{c}</li>)}</ol>
            <a class="textlink" href="/college-soccer-recruitment/">Read the guide →</a>
          </div>
          {d!.category === 'Middle school' && (
            <div class="card box">
              <p class="eyebrow">Grades 5 to 8</p>
              <p class="box-h">Junior Prep Coaching</p>
              <p class="muted small">Online coaching, accountability and support so your athlete reaches high school ready.</p>
              <a class="textlink" href="/junior-prep-coaching/">Explore Junior Prep →</a>
            </div>
          )}
        </aside>
      </div>
      {related.length > 0 && (
        <section class="section section-alt" aria-labelledby="next-h">
          <div class="wrap">
            <h2 id="next-h">Read Next</h2>
            <div class="grid">{related.map((p) => <PostCard post={p} small />)}</div>
          </div>
        </section>
      )}
    </article>
  )}
</Base>

<style>
  .post-head { padding-top: 40px; padding-bottom: 8px; }
  .post-head h1 { font-size: clamp(34px, 4.6vw, 52px); }
  .crumbs { font-size: 14px; color: var(--dim); margin-bottom: 20px; }
  .crumbs a { color: var(--dim); }
  .byline { display: flex; align-items: center; gap: 14px; }
  .byline :global(img) { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; border: 2px solid var(--gold); }
  .who { margin: 0; font-weight: 700; color: #fff; }
  .meta { margin: 0; font-size: 15px; color: var(--dim); }
  .post-head :global(.hdr) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; }
  .post-body { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; padding-top: 40px; padding-bottom: 80px; }
  .main { flex: 999 1 620px; min-width: 0; max-width: 760px; }
  .side { flex: 1 1 280px; min-width: 0; display: grid; gap: 20px; position: sticky; top: 96px; }
  .guide-line { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 18px 0; margin: 36px 0; }
  .cta { background: var(--gold); color: var(--ink); border-radius: 14px; padding: 28px; margin-bottom: 32px; }
  .cta-h { font-family: var(--display); font-weight: 700; font-size: 24px; text-transform: uppercase; margin: 0 0 8px; }
  .dark { background: var(--ink); border-color: var(--ink); color: var(--gold); }
  .dark:hover { color: var(--gold); background: #26262b; }
  .line { border-color: var(--ink); color: var(--ink); }
  .line:hover { background: var(--ink); color: var(--gold); }
  .bio { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; padding: 24px; }
  .bio > div { flex: 1 1 320px; min-width: 0; }
  .bio :global(img) { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; border: 2px solid var(--gold); }
  .bio-h, .box-h { font-family: var(--display); font-weight: 600; font-size: 20px; text-transform: uppercase; color: #fff; margin: 0 0 8px; }
  .bio p:last-child { margin: 0; font-size: 16px; }
  .box { padding: 24px; }
  .box ol { padding-left: 20px; font-size: 15px; color: var(--muted); display: grid; gap: 6px; margin: 0 0 12px; }
  .small { font-size: 15px; }
  .legal { margin-top: 24px; }
  @media (max-width: 900px) { .side { position: static; } }
</style>
