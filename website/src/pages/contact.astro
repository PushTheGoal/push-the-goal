---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Contact Push The Goal | College Soccer Recruiting Coach" description="Questions about college soccer recruiting? Contact Push The Goal to reach coach Izi Murray, or book a free 45-minute strategy call for your athlete.">
  <section class="section">
    <div class="wrap split" style="align-items: flex-start">
      <div>
        <p class="eyebrow">Ways to reach us</p>
        <h1>Let's Talk About Your Athlete's Recruiting</h1>
        <p class="lead">Whether you're just starting to explore college soccer recruiting or you're deep in the process and need a second opinion, we're here to help. Reach out below, or book a free 45-minute strategy call and we'll map out where your athlete stands.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={site.booking}>Book Your Recruiting Strategy Call</a>
          <a class="btn btn-outline" href={site.instagram}>DM on Instagram</a>
        </div>
        <ul class="ways">
          <li><span>Email</span> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><span>Hours</span> {site.hours}</li>
        </ul>
      </div>
      <form class="card form" method="post" action="/api/contact">
        <h2>Send a Message</h2>
        <label for="athlete">Athlete name</label>
        <input id="athlete" name="athlete" autocomplete="name" required>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
        <label for="phone">Phone or WhatsApp</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel">
        <label for="interest">Interested in</label>
        <select id="interest" name="interest">
          <option>Soccer Recruiting Coach</option>
          <option>Junior Prep</option>
        </select>
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5"></textarea>
        <div class="hp" aria-hidden="true"><label for="website">Leave this empty</label><input id="website" name="website" tabindex="-1" autocomplete="off"></div>
        <button class="btn btn-primary" type="submit">Send Message</button>
      </form>
    </div>
  </section>
</Base>
<style>
  .ways { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 10px; }
  .ways span { font-family: var(--display); letter-spacing: 1px; text-transform: uppercase; color: var(--gold); margin-right: 8px; }
  .form { padding: 28px; display: grid; gap: 8px; }
  .form h2 { font-size: 28px; }
  label { font-weight: 500; margin-top: 8px; }
  input, select, textarea { width: 100%; font: inherit; color: var(--text); background: var(--ink); border: 1px solid #3f3f46; border-radius: 0; padding: 12px 14px; min-height: 48px; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--gold); border-color: var(--gold); }
  button { margin-top: 16px; cursor: pointer; }
  .hp { position: absolute; left: -9999px; }
</style>
