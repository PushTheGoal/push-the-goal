---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Free Recruiting Strategy Call | Push The Goal" description="Book a free 45-minute college soccer recruiting strategy call with Coach Izi Murray. Find your athlete's biggest recruiting gap and leave with a plan.">
  <section class="section">
    <div class="wrap narrow center">
      <p class="eyebrow">Free · 45 minutes · Online</p>
      <h1>Book Your Free Recruiting Strategy Call</h1>
      <p class="lead">In about 45 minutes we find your athlete's single biggest recruiting gap and their top priorities, and you leave knowing what to do next, whatever grade they're in.</p>
      <div class="btn-row" style="justify-content: center">
        <a class="btn btn-primary" href={site.booking}>Pick a Time</a>
        <a class="btn btn-outline" href={site.instagram}>DM on Instagram</a>
      </div>
      <p class="muted" style="margin-top: 32px">Younger player in grades 5 to 8? The same link books a <a href="/junior-prep-coaching/">Junior Prep</a> intro call.</p>
    </div>
  </section>
</Base>
