---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Thank You | Push The Goal" description="Your message reached Push The Goal." noindex>
  <section class="section">
    <div class="wrap narrow center">
      <p class="eyebrow">Message sent</p>
      <h1>Thank You. Izi Will Be in Touch.</h1>
      <p class="lead">We reply Monday to Saturday, 9 AM to 5 PM. Want to move faster? Book a free strategy call now.</p>
      <div class="btn-row" style="justify-content: center">
        <a class="btn btn-primary" href={site.booking}>Book Your Recruiting Strategy Call</a>
        <a class="btn btn-outline" href="/college-soccer-recruitment/">Read the Guide</a>
      </div>
    </div>
  </section>
</Base>
