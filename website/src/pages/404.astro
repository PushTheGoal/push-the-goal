---
// Custom "page not found". Cloudflare Pages serves this (with a 404 status) for any address the site
// does not have. Old WordPress addresses are kept or redirected, so most visitors never see it.
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const now = new Date();
const posts = (await getCollection('blog', (p) => !p.data.draft && p.data.date <= now)).sort((a, b) => +b.data.date - +a.data.date);
const latest = posts.slice(0, 3);
// Small list for the "were you looking for" match and the search box (titles and slugs only).
const index = posts.map((p) => ({ t: p.data.title, u: `/${p.id}/`, c: p.data.category }));

const places = [
  { href: '/college-soccer-recruitment/', label: 'The Recruitment Guide', note: 'Timelines, coach outreach, video and money, explained for parents.' },
  { href: '/junior-prep-coaching/', label: 'Junior Prep', note: 'Grades 5 to 8: build the habits before recruiting starts.' },
  { href: '/blog/', label: 'The Blog', note: 'Straight answers to the questions families ask Izi most.' },
  { href: '/about-izi/', label: 'Meet Coach Izi', note: 'Who she is and how she works with families.' },
];
---
<Base title="Page Not Found | Push The Goal" description="That page isn't here. Find the recruiting guide, Junior Prep, the blog or book a free call with Coach Izi." noindex>
  <section class="miss" aria-labelledby="miss-h">
    <div class="wrap miss-in">
      <div class="score" aria-hidden="true">
        <span>4</span>
        <svg class="ball" viewBox="0 0 100 100" role="presentation">
          <defs><clipPath id="ball-clip"><circle cx="50" cy="50" r="46" /></clipPath></defs>
          <circle cx="50" cy="50" r="46" fill="#fff" />
          <g clip-path="url(#ball-clip)" fill="#0b0b0e" stroke="#0b0b0e" stroke-width="1.5" stroke-linejoin="round">
            <polygon points="50.0,34.0 65.2,45.1 59.4,62.9 40.6,62.9 34.8,45.1" />
            <polygon points="50.0,17.0 33.8,5.3 40.0,-13.8 60.0,-13.8 66.2,5.3" />
            <polygon points="81.4,39.8 87.6,20.8 107.5,20.8 113.7,39.8 97.6,51.5" />
            <polygon points="69.4,76.7 89.4,76.7 95.6,95.7 79.4,107.5 63.2,95.7" />
            <polygon points="30.6,76.7 36.8,95.7 20.6,107.5 4.4,95.7 10.6,76.7" />
            <polygon points="18.6,39.8 2.4,51.5 -13.7,39.8 -7.5,20.8 12.4,20.8" />
            <path fill="none" d="M50.0 34.0 L50.0 17.0 M65.2 45.1 L81.4 39.8 M59.4 62.9 L69.4 76.7 M40.6 62.9 L30.6 76.7 M34.8 45.1 L18.6 39.8" />
          </g>
          <circle cx="50" cy="50" r="46" fill="none" stroke="#f4f4f5" stroke-width="2.5" />
        </svg>
        <span>4</span>
      </div>
      <p class="eyebrow">Page not found</p>
      <h1 id="miss-h">That One Went Wide</h1>
      <p class="lead">The page you were looking for has moved or never existed. Every page from the old site still works, so if a link somewhere sent you here, let Izi know at <a href={`mailto:${site.email}`}>{site.email}</a> and she'll get it fixed.</p>

      <div id="guess" class="guess" hidden>
        <p class="guess-h">Were you looking for one of these?</p>
        <ul id="guess-list"></ul>
      </div>

      <form class="find" role="search" onsubmit="return false">
        <label for="find-q">Search the blog</label>
        <div class="find-row">
          <input id="find-q" type="search" placeholder="Try: highlight video, D3, emailing coaches" autocomplete="off" />
        </div>
        <ul id="find-list" class="find-list" aria-live="polite"></ul>
      </form>

      <div class="btn-row center-row">
        <a class="btn btn-primary" href={site.booking}>Book a Free Strategy Call</a>
        <a class="btn btn-outline" href="/">Back to the Home Page</a>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="places-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Get back in the game</p>
        <h2 id="places-h">Where Families Usually Head Next</h2>
      </div>
      <div class="grid places">
        {places.map((p) => (
          <a class="card place" href={p.href}>
            <h3>{p.label}</h3>
            <p>{p.note}</p>
            <span class="go" aria-hidden="true">Go &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section" aria-labelledby="latest-h">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Fresh from the blog</p>
          <h2 id="latest-h">Latest Recruiting Answers</h2>
        </div>
        <div class="grid">
          {latest.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBand heading="Still Not Sure Where to Start?">
    <p>Most families land here with one question they can't get a straight answer to. Bring it to a free call and Izi will tell you exactly where your athlete stands and what to do next.</p>
  </CtaBand>

  <script is:inline define:vars={{ index }}>
    (function () {
      var stop = { the: 1, a: 1, and: 1, to: 1, of: 1, for: 1, in: 1, your: 1, how: 1, what: 1, is: 1, do: 1, my: 1, on: 1, with: 1 };
      function words(s) {
        s = (s || '').toLowerCase()
          .replace(/division[\s-]*(iii|three|3)\b/g, 'd3').replace(/division[\s-]*(ii|two|2)\b/g, 'd2').replace(/division[\s-]*(i|one|1)\b/g, 'd1')
          .replace(/\bd[\s-](1|2|3)\b/g, 'd$1');
        return s.replace(/[^a-z0-9]+/g, ' ').split(' ').filter(function (w) { return w.length > 1 && !stop[w]; }); }
      function item(p) {
        var li = document.createElement('li'); var a = document.createElement('a');
        a.href = p.u; a.textContent = p.t; var s = document.createElement('span'); s.textContent = p.c;
        li.appendChild(a); li.appendChild(s); return li;
      }
      function rank(q) {
        var qw = words(q); if (!qw.length) return [];
        return index.map(function (p) {
          var tw = words(p.t + ' ' + p.u + ' ' + p.c), score = 0;
          qw.forEach(function (w) { tw.forEach(function (t) { if (t === w) score += 3; else if (t.indexOf(w) === 0 || w.indexOf(t) === 0) score += 1; }); });
          return { p: p, s: score };
        }).filter(function (r) { return r.s > 0; }).sort(function (a, b) { return b.s - a.s; });
      }
      // Guess from the address they typed or followed (for example /recruiting-video-tips/).
      var guess = rank(decodeURIComponent(location.pathname)).filter(function (r) { return r.s >= 3; }).slice(0, 3);
      if (guess.length) {
        var gl = document.getElementById('guess-list');
        guess.forEach(function (r) { gl.appendChild(item(r.p)); });
        document.getElementById('guess').hidden = false;
      }
      var q = document.getElementById('find-q'), out = document.getElementById('find-list');
      q.addEventListener('input', function () {
        out.textContent = '';
        if (q.value.trim().length < 2) return;
        var hits = rank(q.value).slice(0, 6);
        if (!hits.length) { var li = document.createElement('li'); li.className = 'none'; li.textContent = 'No posts match that yet. Izi answers it on a free call.'; out.appendChild(li); return; }
        hits.forEach(function (r) { out.appendChild(item(r.p)); });
      });
    })();
  </script>
</Base>

<style>
  .miss { position: relative; overflow: hidden; padding: 72px 0 88px; text-align: center;
    background: radial-gradient(ellipse at 50% 120%, rgba(248, 227, 77, 0.12) 0%, rgba(11, 11, 14, 0) 60%), var(--ink); }
  .miss::before { content: ''; position: absolute; inset: auto 0 0 0; height: 45%; pointer-events: none;
    background: repeating-linear-gradient(90deg, rgba(255,255,255,0.025) 0 80px, rgba(255,255,255,0) 80px 160px);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000); mask-image: linear-gradient(180deg, transparent, #000); }
  .miss-in { position: relative; max-width: 820px; }
  .score { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 18px;
    font-family: var(--display); font-weight: 700; font-size: clamp(110px, 22vw, 200px); line-height: 1; color: var(--gold); }
  .ball { width: 0.78em; height: 0.78em; animation: spin 7s linear infinite; filter: drop-shadow(0 10px 18px rgba(0,0,0,0.5)); }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .ball { animation: none; } }
  .lead { margin-left: auto; margin-right: auto; max-width: 640px; }
  .guess { margin: 28px auto 0; max-width: 620px; text-align: left; background: var(--panel); border: 1px solid var(--gold); border-radius: var(--radius); padding: 18px 22px; }
  .guess-h { font-family: var(--display); text-transform: uppercase; letter-spacing: 1px; color: var(--gold); margin: 0 0 8px; }
  .guess ul, .find-list { list-style: none; margin: 0; padding: 0; }
  .guess :global(li), .find-list :global(li) { padding: 10px 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; }
  .guess :global(li:first-child) { border-top: 0; }
  .guess :global(li span), .find-list :global(li span) { font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--dim); font-family: var(--display); }
  .guess :global(a), .find-list :global(a) { color: var(--text); text-decoration: none; font-weight: 500; }
  .guess :global(a:hover), .find-list :global(a:hover) { color: var(--gold); }
  .find { margin: 32px auto 0; max-width: 620px; text-align: left; }
  .find label { display: block; font-family: var(--display); text-transform: uppercase; letter-spacing: 2px; font-size: 14px; color: var(--muted); margin-bottom: 8px; }
  .find input { width: 100%; min-height: 52px; padding: 12px 16px; border-radius: 10px; border: 1px solid var(--line); background: var(--panel); color: var(--text); font: inherit; }
  .find input:focus { border-color: var(--gold); outline: none; box-shadow: 0 0 0 3px rgba(248, 227, 77, 0.25); }
  .find-list :global(li.none) { color: var(--dim); }
  .center-row { justify-content: center; margin-top: 36px; }
  .places { grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .place { display: flex; flex-direction: column; padding: 26px 24px; text-decoration: none; color: var(--text); transition: border-color .15s, transform .15s; }
  .place:hover { border-color: var(--gold); color: var(--text); transform: translateY(-3px); }
  .place h3 { margin-bottom: 10px; }
  .place p { color: var(--muted); flex: 1; }
  .go { font-family: var(--display); text-transform: uppercase; letter-spacing: 1px; color: var(--gold); }
  @media (max-width: 600px) { .miss { padding: 48px 0 64px; } .btn-row.center-row .btn { width: 100%; } }
</style>
